artifacts/preprocessors/*
!artifacts/preprocessors/.gitkeep
artifacts/metadata/*
!artifacts/metadata/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
*.joblib
*.pkl
*.pickle
*.keras
*.h5
*.ckpt
*.onnx

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

