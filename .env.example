# ==============================================================================
# PhishGuard Environment Configuration Template
# Copy this file to .env and configure local/environment-specific values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Model Inference Configuration
MODEL_DEFAULT=ann
MODEL_ARTIFACT_DIR=artifacts/models
PREPROCESSOR_ARTIFACT_DIR=artifacts/preprocessors

# Security & CORS Settings
# Comma-separated list of allowed origins for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging & Telemetry
LOG_LEVEL=INFO

# Cloud Deployment (Google Cloud Run / Artifact Registry)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
ARTIFACT_REGISTRY_REPO=phishguard-repo
